// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}



// stores profile of a user 
model User{ 
  id          String      @id @default(cuid())
  password    String
  email       String      @unique
  lastName    String?
  firstName   String?
  avatar      String? 
  plan        String      @default("free")

  //Relations
  sessions    Session[]
  forms       Form[]
  
  //Basics
  createdAt     DateTime  @default(now())

  //making search easy. 
  @@index([email])

  // Use this line to make the database table lowercase 'users'
  @@map("users")


}


// each row is an authentication session.
// storing JWT for authentication with expiration.  
model Session{
  id          String      @id @default(cuid())
  token       String      @unique @db.Text
  userId      String         // foriegn key. 
  expiresAt   DateTime  

  //Relations
  user  User  @relation(fields:[userId], references:[id],onDelete: Cascade  )
  
  //Basics
  createdAt     DateTime  @default(now())

  //making search easy. 
  @@index([userId])
  @@index([token])

  // Use this line to make the database table lowercase 'users'
  @@map("sessions")
}


// Form data created by a user  
model Form{ 
  id          String      @id @default(cuid())  // removed "publishedUrl" and only storing the fromId(slug). we are safe even if domain name changes.
  title         String 
  description   String? 
  blocks        Json                        // what field a "x" user contains?
  settings      Json                        // Additional configuration
  published     Boolean     @default(false) // can we see form or not as if we editing then users can't see this form. 
  userId        String
  password       String?                    // Hashed password: should be filled by every person before filling the form. we don't data from everybody (organizations). 
  expiresAt      DateTime?                 // For the "Close on specific date" feature

  // Relations
  author User @relation(fields: [userId] , references: [id], onDelete:Cascade ) // Whenever a User record is deleted, all related records in the table 
  submissions   Response[]

  // Basics
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  //making search easy. 
  @@index([userId])
  @@index([published])

  // Use this line to make the database table lowercase 'users'
  @@map("forms")
}


// contains data and insights about data 
model Response{ 
  id          String         @id @default(cuid())
  data          Json
  summary       String?                             //AI-generated summary 
  score         Int?                                //Lead quality score out of 100. 
  formId        String           
  ipAddress     String?                             // To prevent spam/duplicate submissions.
  userAgent     String?                             // Information about user's operating system and their browser used to visit our site. 

  // Relations
  form Form @relation(fields:[formId], references: [id],onDelete: Cascade)

  // Basics
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  //making search easy. 
  @@index([formId])
  @@index([createdAt])

  // Use this line to make the database table lowercase 'users'
  @@map("responses")
}
